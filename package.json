{
  "name": "dsh-method",
  "version": "0.2.1",
  "type": "module",
  "description": "Subagent orchestration for the DeepSeek Harness: the main conversation routes models and dispatches work; members submit plan flowcharts, the conversation picks one and lights up progress, and both the web and phone panels read the same orchestration state.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LMQ00/dsh-method.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "orchestration",
    "subagent"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./store": "./store.js",
    "./schema": "./schema.js",
    "./prompt": "./prompt.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "store.js",
    "schema.js",
    "prompt.js",
    "cordis.patch.yml",
    "selftest.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node selftest.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": ["react"]
    }
  }
}
